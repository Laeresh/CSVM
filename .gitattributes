# C# is stored LF and checked out CRLF on every OS, because .editorconfig asks dotnet format for
# CRLF. Without this only a Windows clone with core.autocrlf=true gets CRLF: on macOS and Linux
# dotnet format rewrites every line, and a commit after it stores CRLF.
*.cs text eol=crlf

# The launch-resolution baseline is compared byte for byte against a freshly captured file, not
# only through `git diff`. With core.autocrlf=true a checkout would hand it CRLF while capture.ps1
# writes LF, and every line of a 6000-line file would read as changed on any fresh clone.
analysis/session-baseline/baseline.txt text eol=lf

# The zip's VR launcher is a batch file, which cmd reads line by line and expects CRLF in. Checked out
# CRLF on every OS, so an export from any clone ships it as Windows runs it.
packaging/*.cmd text eol=crlf

# The master server's deployment files are read on a Linux host, often copied there from a
# Windows checkout rather than cloned: a CR in .env, the coturn config or the systemd unit ends up
# inside a value. Checked out LF on every OS.
server/.env.example text eol=lf
server/Caddyfile text eol=lf
server/Dockerfile text eol=lf
server/Dockerfile.dockerignore text eol=lf
server/docker-compose.yml text eol=lf
server/coturn/*.conf text eol=lf
server/systemd/*.service text eol=lf
