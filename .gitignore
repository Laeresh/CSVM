# HARD RULE (XWVM legal model): the game install and anything derived from it
# must NEVER be committed. Code and format documentation only.
/CrimsonSkiesGame/
/extracted/
/tools/
# Archives: every zip in this tree so far has been game data or an extraction of it
# (CSVM-Complete.zip, the unzbd outputs). Ignored as a class rather than by name, so the
# next one is covered too — no .zip has ever been tracked here. Un-ignore a specific
# file with `git add -f` if a genuinely code-only archive ever needs committing.
*.zip

# Godot / .NET build artifacts
/CSVM/.godot/
/CSVM/bin/
/CSVM/obj/
*.screenshot.png
# F12 in-game screenshots (rendered game frames = game-derived, must not be committed)
/Screenshots/

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
*.swp
CopyToOneDrive.ps1

# Reference captures of the original game — screenshots and videos alike.
# Kept locally and referenced by docs/backlog by filename; never committed.
# (The Videos/ subfolder was already ignored; 2026-07-22 this widened to the
# whole folder, and the previously-tracked screenshots were untracked.)
/OriginalScreenshots/

# Claude Code scratch/probe artifacts
.scratch/
# Claude Code agent worktrees/workspaces — transient checkouts created by
# `isolation: worktree` subagents. They are real git worktrees of THIS repo;
# committing them would embed repos inside the repo. Added 2026-07-22 after
# `git add -A` swept five of them in. `workspaces/` is the same thing under a
# different name in newer Claude Code builds — ignored pre-emptively.
# NOTE: /.claude/skills/ is deliberately NOT ignored; project skills are committed.
/.claude/worktrees/
/.claude/workspaces/
# Personal backlog, ideas and other things
NOTES.md
# Python bytecode from analysis/ scripts
__pycache__/
*.pyc

.env