# Copy to server/.env and fill in. docker compose reads it; never commit the filled-in copy.

# The one DNS name the game, Caddy and coturn use, pointing at this VPS.
CSVM_DOMAIN=csvm.example.org

# This VPS's public IPv4 address, which coturn hands out in its relay candidates.
PUBLIC_IP=203.0.113.10

# The secret the master server signs TURN credentials with and coturn checks them against.
# Generate one with: openssl rand -hex 32
TURN_SECRET=replace-with-64-hex-characters
