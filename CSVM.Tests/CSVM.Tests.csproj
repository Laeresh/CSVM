<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>CSVM.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The engine project builds under Godot.NET.Sdk; only its managed output is referenced
         here, so the test host never needs the Godot editor or its export presets. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!-- No InvariantGlobalization here, unlike the engine: the culture-safety units build de-DE
         to prove every format is invariant, which only a host with ICU can construct. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSVM\CSVM.csproj" />
    <!-- The master server, run on an in-memory host against the game's own socket code. It
         compiles the game's wire file too, so its types live behind an alias. -->
    <ProjectReference Include="..\server\MasterServer\MasterServer.csproj" Aliases="master" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
