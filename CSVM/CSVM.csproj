<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>CSVM</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit project reads a member the engine has no shipped caller for, so the member stays
         off the public surface instead of being published for one test. -->
    <InternalsVisibleTo Include="CSVM.Tests" />
  </ItemGroup>
</Project>
