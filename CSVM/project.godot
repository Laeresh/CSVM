; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="CSVM"
; The build's one version number. The engine reads it at startup for the log's first line and the
; launchscreen's corner, ExportRelease.ps1 reads it back to name the zip, and the Windows export
; stamps it into the exe's file properties. Bump it here and nowhere else.
config/version="0.3.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/no_focus=true
window/size/no_focus.template=false

[dotnet]

project/assembly_name="CSVM"

[gui]

; Mipmaps on the theme font, for the separate render thread below rather than for looks: canvas text
; samples without them, so no pixel moves. Only a font with mipmaps makes Godot upload a copy of its
; glyph atlas. Without them it uploads the atlas it goes on writing new glyphs into, and the render
; thread reads that torn or empty ("p_image->is_empty()" from _texture_2d_update).
theme/default_font_generate_mipmaps=true

[rendering]

anti_aliasing/quality/msaa_3d=2
; The rendering server runs on its own thread (Separate), so one frame's draw overlaps the next
; frame's simulation. Godot 4.7 still calls the model experimental and says so in a startup warning.
; The game's hand-offs to that thread are written for it: textures repainted in play upload through
; src/Utils/TextureUpload.cs, the per-frame render times through MeasuredRenderTime.cs, and pane
; readbacks through PaneReadback.cs, and every font keeps mipmaps ([gui] above). `--render-thread
; safe` runs one thread again, for an A/B.
; How the --perf split reads under it: docs/verification.md PERF-43.
driver/threads/thread_model=2
; 16x anisotropic (level 4) for the world's grazing-angle ground; the SceneBuilder shader
; samples albedo with filter_linear_mipmap_anisotropic. Cheap on modern GPUs. (item 2.)
textures/default_filters/anisotropic_filtering_level=4
; Global shader variable buffer holds our per-mesh node_bias instance uniform (the
; cross-node z-fight tie-break in SceneBuilder). Godot allocates 16 vec4 slots per
; instance, so the 65536 default caps at ~4096 mesh instances; C4 (4234) and C5 (4746)
; overflow it, flooding "Too many instances" errors AND silently dropping node_bias on
; the overflow (decals z-fight again). 262144 (~16384 instances) held one world with
; headroom, but a network harness suite holds three sessions' worlds in one process,
; and inside a shard of sixty suites that overflowed it again. 1048576 = ~65536
; instances, 16 MB, room for three of the largest chapter and the shard's residue.
limits/global_shader_variables/buffer_size=1048576
