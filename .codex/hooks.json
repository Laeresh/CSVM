{
  "description": "Repository safeguards converted from .claude/settings.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-use.ps1\"",
            "timeout": 300,
            "statusMessage": "repository policy checks..."
          }
        ]
      }
    ]
  }
}
