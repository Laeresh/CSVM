+    // TEMPORARY measurement levers, not for landing.
+    private static readonly string I124Levers = System.Environment.GetEnvironmentVariable("CSVM_I124") ?? string.Empty;
+    public static float I124FogFar;
+    private static bool _i124ClutterDone;
+    private bool _i124EnvDone;
+    private bool _i124FarLogged;
+
+    private static bool I124(string key) => I124Levers.Contains(key, StringComparison.Ordinal);
+
+    // Moves every layer-1 MultiMeshInstance3D (the clutter cells) onto the sun's layer, which every
+    // pane draws and no disc does.
+    private void I124Clutter()
+    {
+        if (_i124ClutterDone || !I124("noclutter") || !Utils.GraphicsMode.Enhanced)
+        {
+            return;
+        }
+
+        _i124ClutterDone = true;
+        int moved = 0;
+        var stack = new Stack<Node>();
+        stack.Push(GetTree().Root);
+        while (stack.Count > 0)
+        {
+            var node = stack.Pop();
+            if (node is MultiMeshInstance3D mmi && (mmi.Layers & 1u) != 0)
+            {
+                mmi.Layers = (mmi.Layers & ~1u) | UI.Boards.SplitScreen.SunLayer;
+                moved++;
+            }
+
+            foreach (var child in node.GetChildren())
+            {
+                stack.Push(child);
+            }
+        }
+
+        Utils.Log.Info("flight", $"i124 noclutter moved {moved} multimesh instance(s) off the disc");
+    }
+
+    private void I124Env()
+    {
+        if (_i124EnvDone || !(I124("nossao") || I124("nossr") || I124("noglow")))
+        {
+            return;
+        }
+
+        var env = FindWorld3D()?.Environment;
+        if (env == null)
+        {
+            return;
+        }
+
+        var dup = (Godot.Environment)env.Duplicate();
+        dup.SsaoEnabled = env.SsaoEnabled && !I124("nossao");
+        dup.SsrEnabled = env.SsrEnabled && !I124("nossr");
+        dup.GlowEnabled = env.GlowEnabled && !I124("noglow");
+        _camera.Environment = dup;
+        _i124EnvDone = true;
+        Utils.Log.Info("flight", $"i124 disc env ssao={dup.SsaoEnabled} ssr={dup.SsrEnabled} glow={dup.GlowEnabled} levers={I124Levers}");
+    }
